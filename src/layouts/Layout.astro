---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Simple Relay — One binary. No infrastructure. Reliable HTTP delivery.",
  description = "Simple Relay is a lightweight, self-hosted HTTP relay. Persist before ACK, smart retries with exponential backoff, dead letter queue, and an embedded web UI — all in one binary with zero external dependencies.",
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Simple Relay",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Linux, macOS, Windows, Docker",
  "description": "A lightweight, self-hosted HTTP relay. Receive HTTP, forward HTTP, make delivery reliable. One binary with embedded SQLite — no external brokers or databases required.",
  "url": "https://simplerelay.dev",
  "codeRepository": "https://github.com/simple-relay/simple-relay",
  "license": "https://github.com/simple-relay/simple-relay/blob/main/LICENSE",
  "programmingLanguage": "Go",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Persist before ACK — data committed to SQLite WAL before 200 OK",
    "Exponential backoff with full jitter",
    "Dead Letter Queue with replay API",
    "Embedded Web UI — no Node.js required",
    "Zero external dependencies — no Redis, Kafka, or Postgres",
    "HMAC signature verification for Stripe, GitHub, and more"
  ],
  "keywords": "HTTP relay, webhook reliability, self-hosted, SQLite, retry, dead letter queue, open source"
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://simplerelay.dev/" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="Simple Relay" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Canonical -->
  <link rel="canonical" href="https://simplerelay.dev/" />

  <!-- Favicon: |> icon representing Persist & Deliver -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect x='8' y='10' width='14' height='80' rx='3' fill='%230066cc'/><polygon points='30,50 80,20 80,80' fill='%230066cc'/></svg>" />

  <!-- Inter font (closest open-source equivalent to SF Pro) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class="font-sans text-ink bg-canvas antialiased">
  <slot />
</body>
</html>
