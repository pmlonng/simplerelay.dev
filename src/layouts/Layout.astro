---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Simple HTTP Relay — One binary. No infrastructure. Reliable HTTP delivery.",
  description = "One binary. No infrastructure. Reliable HTTP delivery. Simple HTTP Relay is a lightweight, reliable HTTP tunneling and relay tool."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100 antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>" />
</head>
<body class="min-h-full flex flex-col justify-between selection:bg-indigo-500 selection:text-white relative overflow-x-hidden">
  <!-- Ambient background glow -->
  <div class="fixed inset-0 -z-10 flex items-center justify-center pointer-events-none">
    <div class="w-[600px] h-[600px] bg-indigo-500/10 rounded-full blur-3xl"></div>
  </div>

  <!-- Reusable Navigation Bar -->
  <header class="w-full max-w-5xl mx-auto px-6 py-6 flex items-center justify-between border-b border-slate-900/80">
    <a href="/" class="flex items-center space-x-2 group">
      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-600/20 text-indigo-400 font-mono font-bold text-sm border border-indigo-500/30 group-hover:border-indigo-400/50 transition-colors">
        SR
      </span>
      <span class="font-semibold text-sm tracking-tight text-slate-200 group-hover:text-white transition-colors">simplerelay.dev</span>
    </a>

    <nav class="flex items-center space-x-4">
      <a href="/docs" class="text-xs text-slate-400 hover:text-white transition-colors">Documentation</a>
      <a href="https://github.com/simple-relay" target="_blank" rel="noopener noreferrer" class="text-xs text-slate-400 hover:text-white transition-colors flex items-center gap-1.5 py-1.5 px-3 rounded-full border border-slate-800 bg-slate-900/60 hover:border-slate-700">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
        GitHub
      </a>
    </nav>
  </header>

  <!-- Content Slot -->
  <main class="flex-1 flex flex-col">
    <slot />
  </main>

  <!-- Reusable Footer -->
  <footer class="w-full max-w-5xl mx-auto px-6 py-8 border-t border-slate-900/80 text-center text-xs text-slate-500">
    <p>&copy; {new Date().getFullYear()} Simple HTTP Relay. Released under open-source license.</p>
  </footer>
</body>
</html>
