---
import Layout from '../../layouts/Layout.astro';

const docSections = [
  { id: 'overview', title: '1. Overview' },
  { id: 'quickstart', title: '2. Quickstart' },
  { id: 'configuration', title: '3. Configuration' },
];
---

<Layout title="Documentation — Simple HTTP Relay" description="Documentation and guides for Simple HTTP Relay.">
  <div class="w-full max-w-5xl mx-auto px-6 py-12 flex-1">
    <div class="flex flex-col md:flex-row gap-12">
      <!-- Sidebar -->
      <aside class="w-full md:w-56 shrink-0 border-b md:border-b-0 md:border-r border-slate-900 pb-6 md:pb-0 md:pr-6">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-4">Documentation</h3>
        <ul class="space-y-2 text-sm">
          {docSections.map(section => (
            <li>
              <a href={`#${section.id}`} class="text-slate-400 hover:text-indigo-400 transition-colors block py-1">
                {section.title}
              </a>
            </li>
          ))}
        </ul>
      </aside>

      <!-- Main Docs Content -->
      <article class="flex-1 max-w-2xl prose prose-invert prose-slate">
        <div class="mb-10">
          <span class="text-xs font-mono text-indigo-400">Documentation</span>
          <h1 class="text-3xl font-extrabold text-white mt-1 mb-3">Getting Started</h1>
          <p class="text-slate-400 leading-relaxed">
            Simple HTTP Relay is designed around a single principle:
            <strong class="text-slate-200">"One binary. No infrastructure. Reliable HTTP delivery."</strong>
          </p>
        </div>

        <section id="overview" class="mb-12">
          <h2 class="text-xl font-bold text-white mb-3">1. Overview</h2>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">
            Whether forwarding webhooks to localhost, establishing secure HTTP tunnels behind NAT, or buffering requests, Simple HTTP Relay operates as a standalone zero-dependency binary.
          </p>
        </section>

        <section id="quickstart" class="mb-12">
          <h2 class="text-xl font-bold text-white mb-3">2. Quickstart</h2>
          <p class="text-slate-400 text-sm leading-relaxed mb-3">
            Download the binary for your platform and start relaying:
          </p>
          <div class="p-4 rounded-lg bg-slate-900 border border-slate-800 font-mono text-xs text-slate-300">
            <code># Download and run (coming soon)<br/>simplerelay --listen :8080 --to localhost:3000</code>
          </div>
        </section>

        <section id="configuration" class="mb-12">
          <h2 class="text-xl font-bold text-white mb-3">3. Configuration</h2>
          <p class="text-slate-400 text-sm leading-relaxed">
            Configuration can be passed via command line flags or environment variables. Additional documentation will be published as releases roll out.
          </p>
        </section>
      </article>
    </div>
  </div>
</Layout>
