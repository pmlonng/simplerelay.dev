---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="flex-1 flex flex-col items-center justify-center px-6 py-16 text-center max-w-4xl mx-auto my-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      Phase 1 &bull; Powered by Astro SSG
    </div>

    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white mb-6">
      Simple HTTP Relay
    </h1>

    <p class="text-lg sm:text-2xl font-light text-slate-300 max-w-2xl mx-auto leading-relaxed mb-10">
      One binary. No infrastructure. Reliable HTTP delivery.
    </p>

    <!-- Quick info / CLI placeholder card -->
    <div class="w-full max-w-md p-4 rounded-xl bg-slate-900/80 border border-slate-800 backdrop-blur-sm text-left font-mono text-xs text-slate-400 mb-8 shadow-xl">
      <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-800 text-slate-500">
        <span>quickstart preview</span>
        <span>bash</span>
      </div>
      <div class="flex items-center space-x-2 text-slate-200">
        <span class="text-indigo-400 select-none">$</span>
        <code>simplerelay --listen :8080 --to localhost:3000</code>
      </div>
    </div>

    <!-- Call to actions -->
    <div class="flex items-center gap-3">
      <a href="/docs" class="px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs transition-colors">
        Read the Docs &rarr;
      </a>
      <a href="https://github.com/simple-relay" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 font-medium text-xs transition-colors">
        View on GitHub
      </a>
    </div>
  </div>
</Layout>
